# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# Copy this file as .env.production and fill in values
# before running: npm run build
# =====================================================

# Base URL path for the app.
# Use '/' if hosting at root domain (e.g. domain.com/)
# Use '/subfolder/' if hosting at a subdirectory (e.g. domain.com/subfolder/)
VITE_BASE_URL=/

# Google Apps Script Web App URL (already set in src/config.js)
# VITE_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
